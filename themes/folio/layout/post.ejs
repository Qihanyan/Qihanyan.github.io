<article class="prose">
  <p class="eyebrow"><time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'MMMM D, YYYY') %></time></p>
  <h1><%= page.title %></h1>
  <%- page.content %>
</article>
<nav class="post-nav">
  <% if (page.prev) { %><a href="<%- url_for(page.prev.path) %>">← <%= page.prev.title %></a><% } else { %><span></span><% } %>
  <% if (page.next) { %><a href="<%- url_for(page.next.path) %>"><%= page.next.title %> →</a><% } %>
</nav>
