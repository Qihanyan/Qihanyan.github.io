<% const r = site.data.resume || {}; %>
<!doctype html>
<html lang="<%= config.language || 'en' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page.title ? page.title + ' · ' + config.title : config.title %></title>
  <meta name="description" content="<%= config.description %>">
  <meta property="og:title" content="<%= config.title %>">
  <meta property="og:description" content="<%= config.description %>">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='14' fill='%231f4d3a'/><text x='50%25' y='54%25' text-anchor='middle' dominant-baseline='middle' font-family='Georgia,serif' font-size='34' fill='%23f6f3ec'>FG</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <%- css('css/style') %>
</head>
<body>
  <header class="topbar">
    <div class="wrap topbar-inner">
      <a class="mark" href="<%- url_for('/') %>"><%= r.name || config.author %></a>
      <nav>
        <% if (page.layout === 'home') { %>
          <a href="#experience">Experience</a>
          <a href="#projects">Projects</a>
          <a href="#education">Education</a>
          <% if (site.posts.length) { %><a href="#writing">Writing</a><% } %>
        <% } else { %>
          <a href="<%- url_for('/') %>">Home</a>
          <% if (site.posts.length) { %><a href="<%- url_for('/blog/') %>">Writing</a><% } %>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="wrap">
    <%- body %>
  </main>
  <footer class="wrap footer">
    <span>© <%= new Date().getFullYear() %> <%= r.name || config.author %></span>
    <span><% if (r.email) { %><a href="mailto:<%= r.email %>"><%= r.email %></a><% } %></span>
  </footer>
</body>
</html>
